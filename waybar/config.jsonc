{
  "layer": "bottom",
  "position": "top",
  "height": 44,
  "spacing": 2,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window",
    "group/media"
  ],
  "modules-center": ["clock#simpleclock"],
  "modules-right": [
    "group/volume",
    "cpu",
    "memory",
    "tray",
    //"bluetooth",
    "clock",
    "battery",
    "custom/notification",
    "custom/power"
  ],

  "custom/launcher": {
    "tooltip": false, 
    "on-click": "rofi -show drun",
    "format": ""
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "max-length": 20
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 20
  },

  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },
  "clock#simpleclock": {
    "tooltip": false,
    "format": "{:%H:%M}"
  },
  "clock": {
    "format": " {:L%a %d %b}",
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#f38ba8' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>"
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1
    },
    "tooltip-format": "<span color='#cdd6f4' font='Lexend 16'><tt><small>{calendar}</small></tt></span>"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 1,
    "on-click": "exec foot --title=btop -e btop"
  },
  "memory": {
    "format": " {used:0.1f}Gi",
    "on-click": "exec foot --title=htop -e htop"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "  muted",
    "format-icons": {
      "headphone": "",
      "default": [" ", " ", " "]
    },
    "on-click": "pavucontrol"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ]
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/scripts/powermenu.sh",
    "format": "⏻"
  },

  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh"
  },

  "custom/notification": {
    "format": "{}",
    "exec": "dunstctl is-paused | grep -q 'false' && echo '{\"text\": \"󰂚\"}' || echo '{\"text\": \"󰂛\"}'",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/notif.sh",
    "on-click-right": "dunstctl set-paused toggle",
    "tooltip": false
  },

  "network": {
    "interface": "wlp3s0",
    "format": "{ifname}",
    "format-wifi": "{essid} ",
    "max-length": 50,
    "on-click": "$HOME/.config/waybar/scripts/rofi-wifi-menu.sh"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected" : " {device-alias}",
    "tooltip": true,
    "on-click": "blueman-manager"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "{capacity}%",
    "format-alt": "{time} {icon}",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""]	
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-now-playing",
      "custom/cava"
    ]
  },
  "custom/media-now-playing": {
    "exec": "~/.config/waybar/custom_modules/media/media-now-playing.sh",
    "tooltip": false,
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next"
  },
  "custom/media-animation": {
    "exec": "~/.config/waybar/custom_modules/media/media-animation.sh",
    "tooltip": false
  },
  "custom/media-time": {
    "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
    "escape": true,
    "interval": 1,
    "tooltip": false
  }
}
